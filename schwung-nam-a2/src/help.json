{
  "title": "Nam A2",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Neural Amp Modeler A2.",
        "",
        "Amp modeling, cab IR",
        "and a 3-band EQ in",
        "one Signal Chain",
        "audio effect.",
        "",
        "Loads .nam model",
        "files and optional",
        ".wav cabinet IRs."
      ]
    },
    {
      "title": "Setup",
      "lines": [
        "Copy .nam model",
        "files into models/",
        "and .wav cabinet IRs",
        "into cabs/ using the",
        "Schwung manager at",
        "move.local:7700.",
        "",
        "Find amp models at:",
        "tone3000.com",
        "",
        "Subfolders are",
        "supported for",
        "organization."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Knob 1: Input",
        "Knob 2: Output",
        "Knob 3: Quality",
        " Full or Lite - Lite",
        " halves the neural",
        " net's work if a",
        " model is too heavy",
        " for real-time.",
        "",
        "Cab Bypass, Choose",
        "Model and Choose",
        "Cabinet via the",
        "navigation menu."
      ]
    },
    {
      "title": "3-Band EQ",
      "lines": [
        "Low/Mid/High bands,",
        "each with its own",
        "Gain and Freq knob.",
        "",
        "Low/High are shelf",
        "filters, Mid is a",
        "bell (peak) filter.",
        "Sits after the cab",
        "IR, at the end of",
        "the chain."
      ]
    },
    {
      "title": "Signal Flow",
      "lines": [
        "Input Gain",
        "  > NAM Model",
        "  > Cab IR",
        "  > 3-Band EQ",
        "  > Output Gain",
        "",
        "For delay, reverb",
        "or chorus, add",
        "them as separate",
        "FX in the slot's",
        "own chain."
      ]
    }
  ]
}
