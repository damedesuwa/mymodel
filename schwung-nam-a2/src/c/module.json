{
  "id": "nam-a2c",
  "name": "Nam A2c",
  "abbrev": "A2C",
  "version": "1.2.0",
  "description": "Sixteen blocks in two rows - a main chain and a parallel one, panned and merged where you choose. NAM captures, cab IRs with mic placement, and 50 modelled pedals.",
  "author": "Nam A2 contributors (based on schwung-nam by Charles Vestal / NeuralAudio by Mike Oliphant)",
  "license": "MIT",
  "dsp": "nam-a2c.so",
  "api_version": 2,
  "assets": {
    "path": ".",
    "label": "Assets",
    "extensions": [
      ".nam",
      ".wav",
      ".ir"
    ],
    "allowFolders": true,
    "description": "NAM captures by category (a subfolder of models/ is the category) and cabinet IRs",
    "hint": "Find amp models at",
    "hint_url": "https://tone3000.com",
    "hint_url_label": "TONE3000",
    "folders": [
      {
        "path": "models",
        "label": "Amp captures",
        "extensions": [
          ".nam"
        ],
        "description": "Loose .nam files here are offered under Amp"
      },
      {
        "path": "models/od",
        "label": "Overdrive captures",
        "extensions": [
          ".nam"
        ],
        "description": "Offered inside the OD list, beside the modelled pedals"
      },
      {
        "path": "models/dist",
        "label": "Distortion captures",
        "extensions": [
          ".nam"
        ],
        "description": "Offered inside the Dist list"
      },
      {
        "path": "models/fuzz",
        "label": "Fuzz captures",
        "extensions": [
          ".nam"
        ],
        "description": "Offered inside the Fuzz list"
      },
      {
        "path": "models/boost",
        "label": "Boost captures",
        "extensions": [
          ".nam"
        ],
        "description": "Offered inside the Boost list"
      },
      {
        "path": "cabs",
        "label": "Cabinet IRs",
        "extensions": [
          ".wav",
          ".ir"
        ],
        "description": "Mic placement is applied on top of whichever is loaded"
      }
    ]
  },
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "requires_continuous_processing": true,
    "chain_params": [
      {
        "key": "in_level",
        "name": "Input",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.5,
        "step": 0.01
      },
      {
        "key": "out_level",
        "name": "Output",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.85,
        "step": 0.01
      },
      {
        "key": "cpu",
        "name": "CPU",
        "type": "int",
        "min": 0,
        "max": 100,
        "default": 0,
        "step": 1,
        "unit": "%",
        "access": "read",
        "live": true
      },
      {
        "key": "sel_block",
        "name": "Block",
        "type": "int",
        "min": 0,
        "max": 15,
        "default": 0,
        "step": 1
      }
    ]
  }
}
