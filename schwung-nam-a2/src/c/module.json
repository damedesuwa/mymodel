{
  "id": "nam-a2c",
  "name": "Nam A2c",
  "abbrev": "A2C",
  "version": "1.8.2",
  "description": "Thirty-two blocks over two pages, with a tuner. NAM captures with the amp's tone stack and power-stage sag, cab IRs with mic placement and speaker damping, reverb IRs, a tuning pedal, and 53 modelled pedals. The library refreshes itself.",
  "author": "Nam A2 contributors (based on schwung-nam by Charles Vestal / NeuralAudio by Mike Oliphant)",
  "license": "MIT",
  "dsp": "nam-a2c.so",
  "api_version": 2,
  "assets": {
    "path": ".",
    "label": "Assets",
    "extensions": [
      ".nam",
      ".wav",
      ".ir"
    ],
    "allowFolders": true,
    "description": "Every folder is named after the list it feeds",
    "hint": "Find amp models at",
    "hint_url": "https://tone3000.com",
    "hint_url_label": "TONE3000",
    "folders": [
      {
        "path": "amps",
        "label": "Amp captures (.nam)",
        "extensions": [
          ".nam"
        ],
        "description": "Shown in the Amp list"
      },
      {
        "path": "od",
        "label": "Overdrive captures (.nam)",
        "extensions": [
          ".nam"
        ],
        "description": "Shown in the OD list, after the modelled pedals"
      },
      {
        "path": "dist",
        "label": "Distortion captures (.nam)",
        "extensions": [
          ".nam"
        ],
        "description": "Shown in the Dist list"
      },
      {
        "path": "fuzz",
        "label": "Fuzz captures (.nam)",
        "extensions": [
          ".nam"
        ],
        "description": "Shown in the Fuzz list"
      },
      {
        "path": "boost",
        "label": "Boost captures (.nam)",
        "extensions": [
          ".nam"
        ],
        "description": "Shown in the Boost list"
      },
      {
        "path": "cabs",
        "label": "Cabinet IRs (.wav)",
        "extensions": [
          ".wav",
          ".ir"
        ],
        "description": "Shown in the Cab list. Mic placement is applied on top"
      },
      {
        "path": "reverbs",
        "label": "Reverb IRs (.wav)",
        "extensions": [
          ".wav",
          ".ir"
        ],
        "description": "Rooms, halls, plates, springs. Shown in the Reverb list"
      }
    ]
  },
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "requires_continuous_processing": true,
    "chain_params": [
      {
        "key": "in_level",
        "name": "Input",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.5,
        "step": 0.01
      },
      {
        "key": "out_level",
        "name": "Output",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.85,
        "step": 0.01
      },
      {
        "key": "cpu",
        "name": "CPU",
        "type": "int",
        "min": 0,
        "max": 100,
        "default": 0,
        "step": 1,
        "unit": "%",
        "access": "read",
        "live": true
      },
      {
        "key": "sel_block",
        "name": "Block",
        "type": "int",
        "min": 0,
        "max": 31,
        "default": 0,
        "step": 1
      }
    ],
    "claims_ccs": [
      62,
      63
    ]
  }
}