{
  "id": "nam-a2c",
  "name": "Nam A2c",
  "abbrev": "A2C",
  "version": "0.7.1",
  "description": "Eight freely-typed blocks - NAM capture, cab IR, or any of 50 modelled pedals, in any position",
  "author": "Nam A2 contributors (based on schwung-nam by Charles Vestal / NeuralAudio by Mike Oliphant)",
  "license": "MIT",
  "dsp": "nam-a2c.so",
  "api_version": 2,
  "assets": {
    "path": ".",
    "label": "Assets",
    "extensions": [
      ".nam",
      ".wav",
      ".ir"
    ],
    "allowFolders": true,
    "ensure_dirs": [
      "models",
      "cabs"
    ],
    "description": "Manage NAM models (.nam) and cabinet IRs (.wav)",
    "hint": "Find amp models at",
    "hint_url": "https://tone3000.com",
    "hint_url_label": "TONE3000"
  },
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "requires_continuous_processing": true,
    "chain_params": [
      {
        "key": "in_level",
        "name": "Input",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.5,
        "step": 0.01
      },
      {
        "key": "out_level",
        "name": "Output",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.85,
        "step": 0.01
      },
      {
        "key": "cpu",
        "name": "CPU",
        "type": "int",
        "min": 0,
        "max": 100,
        "default": 0,
        "step": 1,
        "unit": "%",
        "access": "read",
        "live": true
      },
      {
        "key": "sel_block",
        "name": "Block",
        "type": "int",
        "min": 0,
        "max": 7,
        "default": 0,
        "step": 1
      }
    ]
  }
}