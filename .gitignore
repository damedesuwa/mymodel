**/.DS_Store

# Build artifacts
/build/
/dist/
/schwung.tar.gz
/libs/quickjs/quickjs-2025-04-26/.obj/
/libs/quickjs/quickjs-2025-04-26/libquickjs.a
/.worktrees
*.tar.gz
*.tar

# Test patches (kept locally, not committed)
/src/modules/chain/test_patches/

# Build caches
build/cache/
/.cache/

# Binary files that shouldn't be committed
*.wav
*.asd
move_audio_recv
libs/memfault-firmware-sdk/

# Code-graph tooling output (graphify) — never commit
graphify-out/

# SCH-50 UI differentiation catalog renders (contact sheets are committed)
catalog-out/

# Generated audit sheets (tools/param-pages/audit_sheet.mjs) — 759 PNGs.
# Regenerate rather than commit; the report is derived from the fixture.
out/

# Proprietary module assets (ROMs, soundfonts, sample banks) are NEVER stored
# in this repo. They are referenced by absolute path from the untracked
# assets.local.json and pushed straight to the device. Enforced by
# tests/host/test_no_bundled_assets.sh, which checks what git TRACKS — this
# list is the first line of defence, not the only one.
*.sf2
*.sfz
*.rom
*.syx
*.bin
*.wav
*.aif
*.aiff
*.ogg
*.flac
*.mp3
*.m4a
*.nam
*.pcm
*.rx2
*.rex
tools/param-pages/assets.local.json

# ...but tests/fixtures/ is CHECKED-IN DATA, not payload. The blanket rules
# above are there to keep ROMs and samples out of the tree; a captured OLED
# frame is 1 KB of test input that the suite cannot run without. Ignoring it
# passes locally (where the capture still sits on disk) and fails only in CI,
# which is the slowest possible place to learn a fixture was never committed.
!tests/fixtures/*.bin
!tests/fixtures/*.syx
!tests/fixtures/*.wav

# ...and so are a module's BUNDLED assets, for the same reason one step
# further on. The rules above are aimed at payload nobody may redistribute;
# these are the two captures and the one cab IR that ship INSIDE the module
# tarball, so build.sh stages them from here and the module is useless
# without them.
#
# They were not covered, and the cost was invisible: one of the three had
# been force-added once, the other two were uploaded into a working
# container and bundled straight out of it. They lasted exactly as long as
# that container, and the next build on a fresh one would have shipped a
# module with one capture and no cabinet, reporting success. The only
# surviving copy was the release tarball, which is committed for an
# unrelated reason. An asset the build stages belongs in the tree the build
# is made from.
!schwung-nam-a2/src/amps/*.nam
!schwung-nam-a2/src/od/*.nam
!schwung-nam-a2/src/dist/*.nam
!schwung-nam-a2/src/fuzz/*.nam
!schwung-nam-a2/src/boost/*.nam
!schwung-nam-a2/src/cabs/*.wav
!schwung-nam-a2/src/reverbs/*.wav
